body {
    background-color: #9c1000; /* warna merah marron */
    font-familly: Arial, sans-serif; /* Jenis huruf yang bersih dan mudah dibaca */
    color: #014650; /* Warna teks utama (Biru navy) */
 }

.kartu-profil {
    width: 300px;
    margin: 50px auto; /* 50px Jarak atas/bawah, auto menengahkan kiri/kanan */
    padding: 20px;
    background-color: white;
    border-radius: 15px; /* Membuat sudut menjadi melengkung */
    box-shadow: 0 4px rgba(0,0,0,0.1); /* Efek bayangan */
    text-align: center; /* Menengahkan semua teks di dalam kartu */
} 

.kartu-profil img {
   width: 150px;
   border-radius: 50%; /* Trik untuk membuat gambar persegi menjadi lingkaran sempurna */
}
